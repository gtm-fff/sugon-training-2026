{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev dist --port 3000 --persist-to=.wrangler",
    "build": "tsc --noEmit && vite build",
    "deploy:cf": "npm run build && wrangler pages deploy dist --branch main",
    "start": "vite preview --port 3000",
    "test": "node --experimental-strip-types --test test/router.test.ts"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
